# Atlas configuration
# Copy to .env and adjust as needed.

# LLM provider: ollama (OpenAI/Anthropic supported by interface later)
LLM_PROVIDER=ollama
LLM_MODEL=gemma2
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings provider: ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB persistence directory
CHROMA_DIR=./data/chroma

# SQLite database file for documents/conversations
SQLITE_PATH=./data/atlas.db

# Default knowledge base id used when one is not supplied by the client
DEFAULT_KNOWLEDGE_BASE_ID=default

# Retrieval
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.20

# Grounding threshold: above this best-retrieval score the system generates an
# answer; below it, Atlas responds that no relevant information was found.
# This is an INITIAL OPERATIONAL value, not an empirically optimized one.
# It should be validated/calibrated using the M6 evaluation dataset.
GROUNDING_THRESHOLD=0.45

# Chunking defaults
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Upload limits (bytes)
MAX_UPLOAD_SIZE=20971520